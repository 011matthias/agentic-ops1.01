{
  "name": "Accessibility Audit & Cold Email Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "hours", "hoursInterval": 24}]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "sheetId": {"__rl": true, "value": "SHEET_ID_HERE", "mode": "id"},
        "range": "AuditQueue!A:C",
        "options": {"headerRow": 1}
      },
      "id": "read-urls",
      "name": "Read URL Batch",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "// axe-core audit via Puppeteer\n// This is a placeholder -- requires Puppeteer and axe-core installed on server\n\nconst url = $input.item.json.website_url;\nconst company = $input.item.json.company_name;\nconst email = $input.item.json.contact_email;\n\ntry {\n  // In production: launch Puppeteer, navigate to URL, inject axe-core\n  // const browser = await require('puppeteer').launch({headless: true});\n  // const page = await browser.newPage();\n  // await page.goto(url, {timeout: 15000});\n  // const results = await page.evaluate(async () => {\n  //   await new Promise(r => setTimeout(r, 1000));\n  //   return await axe.run();\n  // });\n  \n  return {\n    json: {\n      company_name: company,\n      website_url: url,\n      contact_email: email,\n      status: 'PLACEHOLDER',\n      error_count: 0,\n      top_error_1: '',\n      top_error_2: '',\n      top_error_3: '',\n      audit_timestamp: new Date().toISOString()\n    }\n  };\n} catch (error) {\n  return {\n    json: {\n      company_name: company,\n      website_url: url,\n      contact_email: email,\n      status: error.message.includes('timeout') ? 'TIMEOUT' : 'ERROR',\n      error_count: 0,\n      top_error_1: error.message,\n      top_error_2: '',\n      top_error_3: '',\n      audit_timestamp: new Date().toISOString()\n    }\n  };\n}"
      },
      "id": "axe-core-audit",
      "name": "axe-core Audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "sheetId": {"__rl": true, "value": "SHEET_ID_HERE", "mode": "id"},
        "range": "AuditResults!A:I",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "company_name": "={{ $json.company_name }}",
            "website_url": "={{ $json.website_url }}",
            "status": "={{ $json.status }}",
            "error_count": "={{ $json.error_count }}",
            "top_error_1": "={{ $json.top_error_1 }}",
            "top_error_2": "={{ $json.top_error_2 }}",
            "top_error_3": "={{ $json.top_error_3 }}",
            "audit_timestamp": "={{ $json.audit_timestamp }}"
          }
        }
      },
      "id": "write-results",
      "name": "Write Results to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [860, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "leftValue": "", "typeValidation": "loose"},
          "conditions": [
            {
              "id": "fail-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "FAIL",
              "operator": {"type": "string", "operation": "equals"}
            }
          ]
        }
      },
      "id": "check-fail",
      "name": "Audit Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.instantly.ai/api/v1/lead/add",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "api_key", "value": "INSTANTLY_API_KEY_HERE"},
            {"name": "campaign_id", "value": "CAMPAIGN_ID_HERE"},
            {"name": "email", "value": "={{ $json.contact_email }}"},
            {"name": "first_name", "value": "={{ $json.company_name }}"},
            {"name": "custom_variables", "value": "={{ JSON.stringify({error_count: $json.error_count, top_errors: [$json.top_error_1, $json.top_error_2, $json.top_error_3].filter(e => e).join(', '), website: $json.website_url}) }}"}
          ]
        }
      },
      "id": "instantly-trigger",
      "name": "Trigger Instantly Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": {"__rl": true, "value": "SHEET_ID_HERE", "mode": "id"},
        "range": "EmailLog!A:E",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "recipient": "={{ $('Trigger Instantly Email').item.json.contact_email }}",
            "company": "={{ $('Trigger Instantly Email').item.json.company_name }}",
            "website": "={{ $('Trigger Instantly Email').item.json.website_url }}",
            "timestamp": "={{ new Date().toISOString() }}",
            "campaign_id": "CAMPAIGN_ID_HERE"
          }
        }
      },
      "id": "log-email",
      "name": "Log Email to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1520, 200]
    },
    {
      "parameters": {},
      "id": "skip-pass",
      "name": "Skip (Pass/Blocked)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1300, 400]
    }
  ],
  "connections": {
    "Daily Schedule": {"main": [[{"node": "Read URL Batch", "type": "main", "index": 0}]]},
    "Read URL Batch": {"main": [[{"node": "axe-core Audit", "type": "main", "index": 0}]]},
    "axe-core Audit": {"main": [[{"node": "Write Results to Sheet", "type": "main", "index": 0}]]},
    "Write Results to Sheet": {"main": [[{"node": "Audit Failed?", "type": "main", "index": 0}]]},
    "Audit Failed?": {
      "main": [
        [{"node": "Trigger Instantly Email", "type": "main", "index": 0}],
        [{"node": "Skip (Pass/Blocked)", "type": "main", "index": 0}]
      ]
    },
    "Trigger Instantly Email": {"main": [[{"node": "Log Email to Sheet", "type": "main", "index": 0}]]}
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-03-27T00:00:00.000Z",
  "versionId": "1"
}
