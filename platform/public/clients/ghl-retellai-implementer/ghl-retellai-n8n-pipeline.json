{
  "name": "GHL to Retell AI Call Pipeline (Template)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ghl-pipeline-webhook",
        "options": {}
      },
      "id": "node-webhook-ghl",
      "name": "GHL Pipeline Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "ghl-pipeline-trigger"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-stage-check",
              "leftValue": "={{ $json.body.pipeline_stage }}",
              "rightValue": "qualified",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-stage",
      "name": "Check Pipeline Stage",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.retellai.com/v2/create-phone-call",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_RETELL_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent_id\": \"YOUR_AGENT_ID\",\n  \"customer_number\": \"{{ $json.body.contact_phone }}\",\n  \"metadata\": {\n    \"ghl_contact_id\": \"{{ $json.body.contact_id }}\",\n    \"client_name\": \"{{ $json.body.client_name }}\",\n    \"services\": \"{{ $json.body.services }}\"\n  },\n  \"retell_llm_dynamic_variables\": {\n    \"client_name\": \"{{ $json.body.client_name }}\",\n    \"services\": \"{{ $json.body.services }}\",\n    \"available_slots\": \"{{ $json.body.available_slots }}\"\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-retell-call",
      "name": "Create Retell AI Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "retell-call-webhook",
        "options": {}
      },
      "id": "node-webhook-retell",
      "name": "Retell Callback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 600],
      "webhookId": "retell-callback"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-event-type",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "call_analyzed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-analyzed",
      "name": "Filter call_analyzed Only",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 600]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $json.body.metadata.ghl_contact_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GHL_API_KEY"
            },
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"customFields\": [\n    {\n      \"key\": \"call_outcome\",\n      \"value\": \"{{ $json.body.call_analysis.call_summary }}\"\n    },\n    {\n      \"key\": \"call_transcript\",\n      \"value\": \"{{ $json.body.transcript }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "node-update-ghl",
      "name": "Update GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 500]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log-entry",
              "name": "log",
              "value": "=Call {{ $json.body.call_id }} processed. Contact {{ $json.body.metadata.ghl_contact_id }} updated.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-log",
      "name": "Log Outcome",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 500]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "skip-note",
              "name": "status",
              "value": "Skipped: not a qualified lead",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-skip",
      "name": "Skip (Wrong Stage)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 400]
    },
    {
      "parameters": {
        "content": "## INPUT ZONE\nGHL pipeline webhook trigger.\nReceives contact data when a pipeline stage changes.\n\nRetell callback webhook.\nReceives call events (call_started, call_ended, call_analyzed).",
        "width": 320,
        "height": 380,
        "color": 4
      },
      "id": "node-sticky-input",
      "name": "Sticky: Input Zone",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [140, 220]
    },
    {
      "parameters": {
        "content": "## PROCESSING ZONE\nIF nodes filter by pipeline stage and event type.\nOnly qualified leads trigger calls.\nOnly call_analyzed events trigger GHL updates.",
        "width": 300,
        "height": 380,
        "color": 6
      },
      "id": "node-sticky-process",
      "name": "Sticky: Processing Zone",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [380, 220]
    },
    {
      "parameters": {
        "content": "## OUTPUT ZONE\nRetell API call with dynamic variables.\nGHL contact update with call outcome.\nLog entry for monitoring.\n\nReplace YOUR_RETELL_API_KEY and YOUR_GHL_API_KEY with actual credentials.",
        "width": 320,
        "height": 380,
        "color": 5
      },
      "id": "node-sticky-output",
      "name": "Sticky: Output Zone",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [600, 120]
    }
  ],
  "connections": {
    "GHL Pipeline Webhook": {
      "main": [
        [{ "node": "Check Pipeline Stage", "type": "main", "index": 0 }]
      ]
    },
    "Check Pipeline Stage": {
      "main": [
        [{ "node": "Create Retell AI Call", "type": "main", "index": 0 }],
        [{ "node": "Skip (Wrong Stage)", "type": "main", "index": 0 }]
      ]
    },
    "Retell Callback Webhook": {
      "main": [
        [{ "node": "Filter call_analyzed Only", "type": "main", "index": 0 }]
      ]
    },
    "Filter call_analyzed Only": {
      "main": [
        [{ "node": "Update GHL Contact", "type": "main", "index": 0 }],
        []
      ]
    },
    "Update GHL Contact": {
      "main": [
        [{ "node": "Log Outcome", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "template"
  },
  "tags": [
    { "name": "GHL", "id": "tag-ghl" },
    { "name": "Retell AI", "id": "tag-retell" },
    { "name": "VoiceAI", "id": "tag-voiceai" },
    { "name": "Template", "id": "tag-template" }
  ]
}
