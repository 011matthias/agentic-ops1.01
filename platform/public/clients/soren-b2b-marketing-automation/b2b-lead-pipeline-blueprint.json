{
    "name": "B2B Lead Capture Pipeline",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {},
            "mapper": {},
            "metadata": {
                "designer": { "x": 0, "y": 0 },
                "restore": {},
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    }
                ],
                "expect": [
                    { "name": "email", "type": "text", "label": "Email", "required": true },
                    { "name": "name", "type": "text", "label": "Full Name" },
                    { "name": "company", "type": "text", "label": "Company" },
                    { "name": "source", "type": "text", "label": "Lead Source" }
                ]
            }
        },
        {
            "id": 2,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": {
                "designer": { "x": 300, "y": 0 }
            },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 3,
                            "module": "http:ActionSendData",
                            "version": 3,
                            "parameters": {},
                            "mapper": {
                                "url": "https://api.apollo.io/v1/people/match",
                                "method": "POST",
                                "headers": [
                                    { "name": "Content-Type", "value": "application/json" },
                                    { "name": "x-api-key", "value": "{{parameters.apolloApiKey}}" }
                                ],
                                "body": "{\"email\": \"{{1.email}}\"}"
                            },
                            "metadata": {
                                "designer": { "x": 600, "y": -150 },
                                "expect": [
                                    { "name": "url", "type": "url", "label": "URL" }
                                ]
                            }
                        },
                        {
                            "id": 4,
                            "module": "json:ParseJSON",
                            "version": 1,
                            "mapper": {
                                "json": "{{3.data}}"
                            },
                            "metadata": {
                                "designer": { "x": 900, "y": -150 }
                            }
                        },
                        {
                            "id": 5,
                            "module": "http:ActionSendData",
                            "version": 3,
                            "mapper": {
                                "url": "https://api.hubspot.com/crm/v3/objects/contacts",
                                "method": "POST",
                                "headers": [
                                    { "name": "Content-Type", "value": "application/json" },
                                    { "name": "Authorization", "value": "Bearer {{parameters.hubspotToken}}" }
                                ],
                                "body": "{\"properties\": {\"email\": \"{{1.email}}\", \"firstname\": \"{{1.name}}\", \"company\": \"{{4.person.organization.name}}\", \"jobtitle\": \"{{4.person.title}}\", \"lead_source\": \"{{1.source}}\", \"lead_score\": \"0\"}}"
                            },
                            "metadata": {
                                "designer": { "x": 1200, "y": -150 }
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "confidential": false,
            "dataloss": false,
            "dlq": false
        },
        "designer": {
            "orphans": []
        }
    }
}
