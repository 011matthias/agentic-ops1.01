      "id": "fetch-page",
      "name": "Fetch IR Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 280]
    },
    {
      "parameters": {
        "jsCode": "// Parse HTML and extract all anchor tags with href\nconst html = $input.first().json.data || $input.first().json.body || '';\nconst linkRegex = /<a[^>]+href=[\"']([^\"']+)[\"'][^>]*>(.*?)<\\/a>/gi;\nconst links = [];\nlet match;\nwhile ((match = linkRegex.exec(html)) !== null) {\n  links.push({ url: match[1], text: match[2].replace(/<[^>]*>/g, '').trim() });\n}\nreturn [{ json: { ticker: $input.first().json.ticker, company: $input.first().json.company_name, links, link_count: links.length } }];"
      },
      "id": "parse-html",
      "name": "Extract Links (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 280]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "mode": "list", "value": "claude-haiku-4-5-20251001" },
        "messages": {
          "values": [
            {
              "content": "=You are a financial document link classifier. Given a list of links from a company's investor relations page, classify each link.\n\nCompany: {{ $json.company }} ({{ $json.ticker }})\n\nLinks:\n{{ JSON.stringify($json.links) }}\n\nFor each link, return JSON with: url, title, type (Annual Report, Quarterly Filing, Investor Presentation, Press Release, SEC Filing, Earnings Call Transcript, Proxy Statement, Other), confidence (0-100), year (if identifiable). Separate documents from navigation/noise. Return valid JSON only."
            }
          ]
        },
        "options": { "maxTokensToSample": 2048 }
      },
      "id": "ai-classify",
      "name": "Claude: Classify Links",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [1560, 280],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude response and deduplicate against known documents\nconst response = $input.first().json;\nlet classified;\ntry {\n  classified = typeof response.text === 'string' ? JSON.parse(response.text) : response;\n} catch(e) {\n  classified = { documents: [], error: 'Failed to parse AI response' };\n}\n\n// Dedup: check if document URL already exists in our records\nconst docs = (classified.documents || []).filter(d => d.confidence >= 60);\n\nreturn docs.map(d => ({ json: { ...d, ticker: $('Extract Links (Code)').first().json.ticker, company: $('Extract Links (Code)').first().json.company, status: 'new' } }));"
      },
      "id": "dedup-filter",
      "name": "Dedup + Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 280]
    },
