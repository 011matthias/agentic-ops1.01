              "type": "string"
            },
            {
              "id": "assign-title",
              "name": "title",
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "assign-company-name",
              "name": "company_name",
              "value": "={{ $json.organization?.name ?? $json.company }}",
              "type": "string"
            },
            {
              "id": "assign-company-domain",
              "name": "company_domain",
              "value": "={{ $json.organization?.primary_domain ?? $json.company_domain }}",
              "type": "string"
            },
            {
              "id": "assign-linkedin",
              "name": "linkedin_url",
              "value": "={{ $json.linkedin_url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize-lead-data",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [980, 360]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "email-not-empty",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "validate-email",
      "name": "Validate Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1220, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"system\", \"content\": \"You are a B2B sales researcher. Given a company domain, return a JSON object with the following fields: industry (string), focus (string describing what the company does), size_estimate (string, e.g. '50-200 employees'), pain_points (array of 2-3 strings describing likely business pain points relevant to outbound sales and marketing). Return only valid JSON, no markdown.\"}, {\"role\": \"user\", \"content\": \"Research this company domain: \" + $json.company_domain + \" — Company name: \" + $json.company_name}]"
            },
            {
              "name": "temperature",
              "value": "0.3"
            },
            {
              "name": "max_tokens",
              "value": "400"
            }
          ]
        },
        "options": {}
      },
      "id": "ai-company-research",
      "name": "AI Company Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 260],
      "notes": "Research the lead's company using AI for email personalization"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-research",
              "name": "research",
              "value": "={{ JSON.parse($json.choices[0].message.content) }}",
              "type": "object"
            },
            {
              "id": "assign-industry",
              "name": "industry",
              "value": "={{ JSON.parse($json.choices[0].message.content).industry }}",
              "type": "string"
            },
            {
              "id": "assign-focus",
              "name": "company_focus",
              "value": "={{ JSON.parse($json.choices[0].message.content).focus }}",
              "type": "string"
            },
            {
              "id": "assign-pain-points",
              "name": "pain_points",
              "value": "={{ JSON.parse($json.choices[0].message.content).pain_points?.join('; ') }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "parse-research",
      "name": "Parse Research",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1700, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"system\", \"content\": \"You are a B2B cold email copywriter. Write a personalized cold email using the provided lead and company research data. Output a JSON object with three fields: subject (string), body (string), variant_b_subject (string — an alternative subject line for A/B testing). Keep the body under 150 words. Use a conversational, human tone. Reference something specific about the company. Do not use generic openers. Return only valid JSON, no markdown.\"}, {\"role\": \"user\", \"content\": \"Lead: \" + $json.first_name + \" \" + $json.last_name + \", \" + $json.title + \" at \" + $json.company_name + \". Company focus: \" + $json.company_focus + \". Industry: \" + $json.industry + \". Pain points: \" + $json.pain_points}]"
            },
            {
              "name": "temperature",
              "value": "0.7"
            },
            {
              "name": "max_tokens",
              "value": "500"
            }
          ]
        },
        "options": {}
      },
      "id": "ai-write-email",
      "name": "AI Write Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1940, 260],
      "notes": "Generate personalized email copy using AI and company research"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-subject",
              "name": "email_subject",
              "value": "={{ JSON.parse($json.choices[0].message.content).subject }}",
              "type": "string"
            },
            {
              "id": "assign-body",
              "name": "email_body",
              "value": "={{ JSON.parse($json.choices[0].message.content).body }}",
              "type": "string"
            },
            {
              "id": "assign-variant-b",
              "name": "variant_b_subject",
              "value": "={{ JSON.parse($json.choices[0].message.content).variant_b_subject }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "parse-email",
      "name": "Parse Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2180, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.instantly.ai/api/v1/lead/add",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": "={{$env.INSTANTLY_API_KEY}}"
            },
            {
              "name": "campaign_id",
              "value": "={{$env.INSTANTLY_CAMPAIGN_ID}}"
            },
            {
              "name": "email",
              "value": "={{ $json.email }}"
            },
            {
              "name": "first_name",
              "value": "={{ $json.first_name }}"
            },
            {
              "name": "last_name",
              "value": "={{ $json.last_name }}"
            },
            {
              "name": "company_name",
              "value": "={{ $json.company_name }}"
            },
            {
              "name": "custom_variables",
              "value": "={{ JSON.stringify({ personalized_subject: $json.email_subject, personalized_body: $json.email_body, variant_b_subject: $json.variant_b_subject, company_focus: $json.company_focus, industry: $json.industry }) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "add-to-instantly",
      "name": "Add to Instantly Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 260],
      "notes": "Enroll lead in Instantly.ai campaign with personalized fields"
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": {
          "__rl": true,
          "value": "={{$env.PIPELINE_LOG_SHEET_ID}}",
          "mode": "id"
        },
        "range": "Pipeline Log!A:I",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ new Date().toISOString() }}",
            "first_name": "={{ $json.first_name }}",
            "last_name": "={{ $json.last_name }}",
            "email": "={{ $json.email }}",
            "company": "={{ $json.company_name }}",
            "title": "={{ $json.title }}",
            "campaign": "={{$env.INSTANTLY_CAMPAIGN_ID}}",
            "status": "={{ $json.email ? 'Enrolled' : 'Invalid Email' }}",
            "personalization_data": "={{ JSON.stringify({ subject: $json.email_subject, body: $json.email_body, industry: $json.industry, pain_points: $json.pain_points }) }}"
          }
        },
        "options": {}
      },
      "id": "log-to-sheets",
