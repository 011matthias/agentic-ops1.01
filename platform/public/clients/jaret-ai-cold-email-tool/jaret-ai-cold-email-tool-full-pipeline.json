          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "person_titles",
              "value": "[\"Marketing Manager\", \"Head of Marketing\", \"CMO\"]"
            },
            {
              "name": "organization_num_employees_ranges",
              "value": "[\"11,50\", \"51,200\"]"
            },
            {
              "name": "person_locations",
              "value": "[\"United States\"]"
            },
            {
              "name": "page",
              "value": "1"
            },
            {
              "name": "per_page",
              "value": "25"
            }
          ]
        },
        "options": {}
      },
      "id": "apollo-people-search",
      "name": "Apollo People Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 360],
      "notes": "Search Apollo.io for leads matching your target criteria"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
