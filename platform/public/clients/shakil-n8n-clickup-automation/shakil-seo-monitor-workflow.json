{
  "name": "SEO Monitor - Multi-Site Dashboard",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sites",
              "name": "sites",
              "value": "=[{\"name\":\"sipraw.com\",\"url\":\"https://sipraw.com\"},{\"name\":\"trendRox.com\",\"url\":\"https://trendrox.com\"},{\"name\":\"UK Real Estate\",\"url\":\"https://your-realestate-site.co.uk\"}]",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-sites",
      "name": "Configure Sites",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "sites",
        "options": {}
      },
      "id": "split-sites",
      "name": "Split by Site",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/webmasters/v3/sites/{{ encodeURIComponent($json.sites.url) }}/searchAnalytics/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.googleSearchConsoleOAuth2Api.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"startDate\": \"{{ $now.minus({days: 7}).toFormat('yyyy-MM-dd') }}\",\n  \"endDate\": \"{{ $now.toFormat('yyyy-MM-dd') }}\",\n  \"dimensions\": [\"query\", \"page\"],\n  \"rowLimit\": 50\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "gsc-api",
      "name": "Google Search Console",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const rows = item.json.rows || [];\n  const siteName = item.json.sites?.name || 'Unknown';\n  \n  for (const row of rows) {\n    const query = row.keys?.[0] || '';\n    const page = row.keys?.[1] || '';\n    const position = Math.round(row.position * 10) / 10;\n    const clicks = row.clicks || 0;\n    const impressions = row.impressions || 0;\n    const ctr = Math.round((row.ctr || 0) * 1000) / 10;\n    \n    results.push({\n      json: {\n        site: siteName,\n        query,\n        page,\n        position,\n        clicks,\n        impressions,\n        ctr_percent: ctr,\n        date: new Date().toISOString().split('T')[0]\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "process-rankings",
      "name": "Process Rankings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Rankings",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData"
        },
        "options": {}
      },
      "id": "sheets-append",
      "name": "Update Dashboard",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst alerts = [];\n\n// Check for significant ranking drops\n// Compare current position against a threshold\nconst ALERT_THRESHOLD = 5; // positions\n\nfor (const item of items) {\n  if (item.json.position > 20) {\n    // Flag keywords that dropped below position 20\n    alerts.push({\n      json: {\n        alert_type: 'ranking_drop',\n        site: item.json.site,\n        query: item.json.query,\n        current_position: item.json.position,\n        message: `${item.json.site}: \"${item.json.query}\" is at position ${item.json.position}`,\n        severity: item.json.position > 50 ? 'high' : 'medium',\n        date: item.json.date\n      }\n    });\n  }\n}\n\nif (alerts.length === 0) {\n  alerts.push({\n    json: {\n      alert_type: 'all_clear',\n      message: 'No ranking alerts today. All tracked keywords within normal range.',\n      date: new Date().toISOString().split('T')[0]\n    }\n  });\n}\n\nreturn alerts;"
      },
      "id": "check-alerts",
      "name": "Check for Alerts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "alert-check",
              "leftValue": "={{ $json.alert_type }}",
              "rightValue": "ranking_drop",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-alert",
      "name": "Has Alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 200]
    },
    {
      "parameters": {
        "url": "https://api.clickup.com/api/v2/list/YOUR_CLICKUP_LIST_ID/task",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "YOUR_CLICKUP_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"SEO Alert: {{ $json.site }}\",\n  \"description\": \"{{ $json.message }}\",\n  \"priority\": {{ $json.severity === 'high' ? 1 : 2 }},\n  \"status\": \"to do\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "clickup-task",
      "name": "Create ClickUp Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 100]
    },
    {
      "parameters": {
        "fromEmail": "alerts@your-domain.com",
        "toEmail": "shakil@your-domain.com",
        "subject": "=SEO Alert: {{ $json.site }} - Ranking Drop Detected",
        "emailType": "text",
        "message": "={{ $json.message }}\n\nSeverity: {{ $json.severity }}\nDate: {{ $json.date }}\n\nCheck your SEO dashboard for details."
      },
      "id": "email-alert",
      "name": "Email Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1540, 300],
      "disabled": true
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [[{"node": "Configure Sites", "type": "main", "index": 0}]]
    },
    "Configure Sites": {
      "main": [[{"node": "Split by Site", "type": "main", "index": 0}]]
    },
    "Split by Site": {
      "main": [[{"node": "Google Search Console", "type": "main", "index": 0}]]
    },
    "Google Search Console": {
      "main": [[{"node": "Process Rankings", "type": "main", "index": 0}]]
    },
    "Process Rankings": {
      "main": [
        [
          {"node": "Update Dashboard", "type": "main", "index": 0},
          {"node": "Check for Alerts", "type": "main", "index": 0}
        ]
      ]
    },
    "Check for Alerts": {
      "main": [[{"node": "Has Alerts?", "type": "main", "index": 0}]]
    },
    "Has Alerts?": {
      "main": [
        [{"node": "Create ClickUp Alert", "type": "main", "index": 0}],
        []
      ]
    },
    "Create ClickUp Alert": {
      "main": [[{"node": "Email Notification", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "template"
  },
  "tags": [
    {
      "name": "SEO",
      "id": "seo-tag"
    },
    {
      "name": "Monitoring",
      "id": "monitoring-tag"
    }
  ]
}
