{
  "name": "AI Email Classifier + Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "classify-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst text = input.body?.text || '';\n\nif (!text || text.trim().length === 0) {\n  return [{ json: { error: 'No text provided', status: 400 } }];\n}\n\nreturn [{ json: { text: text.trim(), received_at: new Date().toISOString() } }];"
      },
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an email classifier. Given an email or message, classify it into one of these categories: inquiry, complaint, follow-up, scheduling, internal, spam.\n\nRespond with a JSON object:\n{\n  \"classification\": \"category\",\n  \"confidence\": 0-100,\n  \"reasoning\": \"one sentence explaining why\",\n  \"suggested_action\": \"what to do with this message\",\n  \"tags\": [\"tag1\", \"tag2\"]\n}"
            },
            {
              "role": "user",
              "content": "={{ $json.text }}"
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "maxTokens": 300
        }
      },
      "id": "ai-classify",
      "name": "AI Classification",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [680, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet content = input.message?.content || input.choices?.[0]?.message?.content || '';\n\n// Strip markdown code fences if present\ncontent = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\ntry {\n  const parsed = JSON.parse(content);\n  return [{ json: {\n    classification: parsed.classification || 'unknown',\n    confidence: parsed.confidence || 0,\n    reasoning: parsed.reasoning || '',\n    suggested_action: parsed.suggested_action || '',\n    tags: parsed.tags || []\n  }}];\n} catch (e) {\n  return [{ json: {\n    classification: 'unknown',\n    confidence: 0,\n    reasoning: 'Failed to parse AI response: ' + e.message,\n    suggested_action: 'Manual review required',\n    tags: ['parse-error']\n  }}];\n}"
      },
      "id": "parse-response",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.classification }}",
              "operation": "equals",
              "value2": "inquiry"
            }
          ]
        }
      },
      "id": "route-inquiry",
      "name": "Route: Inquiry",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.classification }}",
              "operation": "equals",
              "value2": "complaint"
            }
          ]
        }
      },
      "id": "route-complaint",
      "name": "Route: Complaint",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Validate Input", "type": "main", "index": 0 }]]
    },
    "Validate Input": {
      "main": [[{ "node": "AI Classification", "type": "main", "index": 0 }]]
    },
    "AI Classification": {
      "main": [[{ "node": "Parse AI Response", "type": "main", "index": 0 }]]
    },
    "Parse AI Response": {
      "main": [[
        { "node": "Route: Inquiry", "type": "main", "index": 0 },
        { "node": "Route: Complaint", "type": "main", "index": 0 },
        { "node": "Respond to Webhook", "type": "main", "index": 0 }
      ]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "pinData": {},
  "versionId": "1",
  "meta": {
    "instanceId": "demo-workflow"
  }
}
