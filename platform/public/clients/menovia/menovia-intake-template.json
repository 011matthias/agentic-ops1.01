{
  "name": "Menovia - Patient Intake Template",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "menovia-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Patient Form Submission",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [440, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-email",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            },
            {
              "id": "check-name",
              "leftValue": "={{ $json.body.name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            },
            {
              "id": "check-consent",
              "leftValue": "={{ $json.body.gdpr_consent }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "validate-input",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "consent-timestamp",
              "name": "gdpr_consent_timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "consent-source",
              "name": "gdpr_consent_source",
              "value": "intake_form",
              "type": "string"
            },
            {
              "id": "consent-version",
              "name": "gdpr_consent_version",
              "value": "1.0",
              "type": "string"
            },
            {
              "id": "patient-name",
              "name": "patient_name",
              "value": "={{ $json.body.name }}",
              "type": "string"
            },
            {
              "id": "patient-email",
              "name": "patient_email",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "patient-phone",
              "name": "patient_phone",
              "value": "={{ $json.body.phone }}",
              "type": "string"
            },
            {
              "id": "selected-package",
              "name": "selected_package",
              "value": "={{ $json.body.package }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "log-consent",
      "name": "Log GDPR Consent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 300]
    },
    {
      "parameters": {
        "url": "https://www.zohoapis.eu/crm/v2/Contacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_ZOHO_ACCESS_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": [\n    {\n      \"First_Name\": \"{{ $json.patient_name.split(' ')[0] }}\",\n      \"Last_Name\": \"{{ $json.patient_name.split(' ').slice(1).join(' ') || '-' }}\",\n      \"Email\": \"{{ $json.patient_email }}\",\n      \"Phone\": \"{{ $json.patient_phone }}\",\n      \"Lead_Source\": \"Website Intake Form\",\n      \"Description\": \"Package: {{ $json.selected_package }}\\nGDPR Consent: {{ $json.gdpr_consent_timestamp }}\\nConsent Source: {{ $json.gdpr_consent_source }}\",\n      \"Lead_Status\": \"New\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "create-crm-contact",
      "name": "Create CRM Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300],
      "notesInFlow": true,
      "notes": "Replace YOUR_ZOHO_ACCESS_TOKEN with actual Zoho OAuth token. Use Zoho EU endpoint (.zohoapis.eu) for GDPR compliance."
    },
    {
      "parameters": {
        "sendTo": "={{ $('Log GDPR Consent').item.json.patient_email }}",
        "subject": "Welkom bij Menovia - Bevestiging van uw aanmelding",
        "emailType": "html",
        "html": "<html>\n<body style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <h2 style=\"color: #4A3560;\">Welkom bij Menovia</h2>\n  <p>Beste {{ $('Log GDPR Consent').item.json.patient_name }},</p>\n  <p>Bedankt voor uw aanmelding bij Menovia. Wij hebben uw gegevens ontvangen en nemen zo snel mogelijk contact met u op.</p>\n  <p><strong>Uw gekozen pakket:</strong> {{ $('Log GDPR Consent').item.json.selected_package }}</p>\n  <p><strong>Volgende stap:</strong> U ontvangt binnenkort een uitnodiging om uw kennismakingsgesprek in te plannen.</p>\n  <hr style=\"border: 1px solid #eee;\">\n  <p style=\"font-size: 12px; color: #888;\">Menovia - Online Menopauze Kliniek<br>Dit bericht is verzonden op basis van uw aanmelding via onze website.<br>U kunt zich op elk moment afmelden door contact met ons op te nemen.</p>\n</body>\n</html>",
        "options": {
          "replyTo": "contact@menovia.nl"
        }
      },
      "id": "send-confirmation",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1540, 300],
      "notesInFlow": true,
      "notes": "Connect to Brevo SMTP credentials. Email content in Dutch. Replace with Brevo Send node for tracking."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "reminder-date",
              "name": "reminder_date",
              "value": "={{ $now.plus(1, 'day').toISO() }}",
              "type": "string"
            },
            {
              "id": "reminder-type",
              "name": "reminder_type",
              "value": "booking_prompt",
              "type": "string"
            },
            {
              "id": "patient-email-ref",
              "name": "patient_email",
              "value": "={{ $('Log GDPR Consent').item.json.patient_email }}",
              "type": "string"
            },
            {
              "id": "patient-name-ref",
              "name": "patient_name",
              "value": "={{ $('Log GDPR Consent').item.json.patient_name }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "schedule-reminder",
      "name": "Schedule Booking Reminder",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1760, 300],
      "notesInFlow": true,
      "notes": "In production: connect to a Wait node or scheduled workflow that sends a booking reminder if the patient hasn't booked within 24h."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"message\": \"Bedankt voor uw aanmelding. U ontvangt een bevestigingsmail.\",\n  \"patient_journey_preview\": {\n    \"step_1\": \"Contact aangemaakt in Zoho CRM (Lead Status: Nieuw)\",\n    \"step_2\": \"Bevestigingsmail verstuurd via Brevo\",\n    \"step_3\": \"Herinnering voor afspraak ingepland (+24u)\",\n    \"step_4\": \"SMS-herinnering bij geen boeking (+48u)\",\n    \"step_5\": \"Voorbereiding consult email (2 dagen voor afspraak)\",\n    \"step_6\": \"Nazorg email sequence (na consult)\"\n  },\n  \"gdpr_audit\": {\n    \"consent_logged\": true,\n    \"timestamp\": \"{{ $('Log GDPR Consent').item.json.gdpr_consent_timestamp }}\",\n    \"source\": \"{{ $('Log GDPR Consent').item.json.gdpr_consent_source }}\",\n    \"version\": \"{{ $('Log GDPR Consent').item.json.gdpr_consent_version }}\",\n    \"eu_hosted\": true,\n    \"data_category\": \"administrative_only\"\n  },\n  \"crm_record\": {\n    \"fields_created\": [\"First_Name\", \"Last_Name\", \"Email\", \"Phone\", \"Lead_Source\", \"Package\", \"GDPR_Consent\"],\n    \"pipeline_stage\": \"Nieuw\",\n    \"next_action\": \"Booking uitnodiging wordt verstuurd\"\n  },\n  \"data_quality\": {\n    \"name_provided\": \"{{ $('Log GDPR Consent').item.json.patient_name ? 'yes' : 'no' }}\",\n    \"email_provided\": \"{{ $('Log GDPR Consent').item.json.patient_email ? 'yes' : 'no' }}\",\n    \"phone_provided\": \"{{ $('Log GDPR Consent').item.json.patient_phone ? 'yes' : 'no' }}\",\n    \"package_selected\": \"{{ $('Log GDPR Consent').item.json.selected_package ? 'yes' : 'no' }}\",\n    \"gdpr_consent\": true\n  }\n}",
        "options": {}
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1980, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"error\",\n  \"message\": \"Verplichte velden ontbreken of toestemming is niet gegeven.\",\n  \"required_fields\": {\n    \"name\": \"Volledige naam\",\n    \"email\": \"E-mailadres\",\n    \"gdpr_consent\": \"Toestemming voor gegevensverwerking (verplicht)\"\n  },\n  \"hint\": \"Controleer of alle velden zijn ingevuld en toestemming is gegeven.\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "error-response",
      "name": "Validation Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 540]
    },
    {
      "parameters": {
        "content": "## Menovia Patient Intake Automation\n**Built by UnpauseAI** | unpauseai.com/clients/menovia\n\nThis workflow automates the complete patient intake process:\n1. Receives form submission via webhook\n2. Validates required fields and GDPR consent\n3. Logs consent with timestamp for compliance\n4. Creates CRM contact in Zoho (EU)\n5. Sends confirmation email in Dutch\n6. Schedules booking reminder\n\n**To set up:** Replace placeholder credentials (Zoho token, Brevo SMTP) with your own. See the onboarding checklist for step-by-step instructions.",
        "width": 1860,
        "height": 140,
        "color": 4
      },
      "id": "sticky-header",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, -200]
    },
    {
      "parameters": {
        "content": "## INPUT\nWebhook receives form data and validates required fields before processing.",
        "width": 380,
        "height": 280,
        "color": 2
      },
      "id": "sticky-input",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [360, 240]
    },
    {
      "parameters": {
        "content": "## DATA PROCESSING\nGDPR consent logging and CRM record creation. All data stays on EU servers.",
        "width": 400,
        "height": 280,
        "color": 6
      },
      "id": "sticky-processing",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [800, 140]
    },
    {
      "parameters": {
        "content": "## OUTPUT\nConfirmation email, booking reminder, and enriched response with journey preview.",
        "width": 600,
        "height": 280,
        "color": 5
      },
      "id": "sticky-output",
      "name": "Sticky Note3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1460, 140]
    },
    {
      "parameters": {
        "content": "**GDPR Compliance**\nConsent is logged BEFORE any data is stored or sent. Timestamp, source, and version are recorded for audit trail. All EU-hosted.",
        "width": 400,
        "height": 90,
        "color": 3
      },
      "id": "sticky-gdpr-note",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [800, 30]
    },
    {
      "parameters": {
        "content": "**Credentials needed:**\n- Zoho CRM: OAuth token (EU endpoint)\n- Brevo: SMTP credentials\n- See onboarding checklist",
        "width": 300,
        "height": 90,
        "color": 1
      },
      "id": "sticky-credentials",
      "name": "Sticky Note5",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1460, 30]
    }
  ],
