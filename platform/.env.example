# platform/.env.example
# Copy to .env.local (gitignored) and fill in. Never commit real values.
# SERVER vars are secrets (server-only). NEXT_PUBLIC_* are exposed to the browser.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/db        # SERVER

# --- Auth (Auth.js / next-auth) ---
AUTH_SECRET=                                          # SERVER: openssl rand -base64 32
AUTH_GOOGLE_ID=                                       # SERVER
AUTH_GOOGLE_SECRET=                                   # SERVER
NEXTAUTH_URL=https://unpauseai.com                    # base URL for auth callbacks

# --- Email (Resend) ---
RESEND_API_KEY=                                       # SERVER
CONTACT_EMAIL=admin@unpauseai.com                     # inbound contact-form recipient
ADMIN_NOTIFICATION_EMAIL=admin@unpauseai.com          # admin notification recipient

# --- Stripe ---
STRIPE_SECRET_KEY=                                    # SERVER
STRIPE_WEBHOOK_SECRET=                                # SERVER
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=                   # browser-exposed publishable key

# --- Anthropic (automation module endpoints) ---
ANTHROPIC_API_KEY=                                    # SERVER

# --- Gated client sites (server-side gate; see .claude/rules/rule_gated_access.md) ---
MASTER_ACCESS_CODE=                                   # SERVER: unlocks every gated site
GATE_AUTH_SECRET=                                     # SERVER: HMAC secret for the grant cookie
                                                      # (WIMMER_AUTH_SECRET is the legacy fallback name)
# One per gated site, pattern <SITE>_ACCESS_CODE:
WIMMER_ACCESS_CODE=                                   # SERVER
MEJI_ACCESS_CODE=                                     # SERVER

# --- Vercel Blob (auto-provisioned on Vercel; set locally only if needed) ---
# BLOB_READ_WRITE_TOKEN=                              # SERVER
