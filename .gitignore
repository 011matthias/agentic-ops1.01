# Environment. Every `.env.<anything>` (.env.local, .env.production, a WW
# n8n .env.prod) can hold a live key; the four template names stay
# committable (layout plan W1-20). file-placement-gate.py mirrors this.
.env
*.env.local
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.eggs/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
ENV/

# Database
*.db
*.sqlite
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/

# Railway
.railway/

# API documentation (fetched, not versioned)
api-docs/

# Google OAuth credentials (never commit these)
client_secrets.json
token.json
**/google-oauth/client_secrets.json
**/google-oauth/token.json

# MCP config (contains API credentials for client instances)
.mcp.json

# Internal tools and credentials (your testing environment)
internal/

# Scripts with hardcoded credentials
scripts/update_workflows.py

# Scratch / intermediate dumps in scripts/ (ephemeral, may contain client PII)
scripts/.*
!scripts/.gitkeep

# Accidental root artifacts
/test.pdf

# Skill vendoring scratch (used by /vendor-skill-style flows)
.tmp/

# Canonical scratch home (rule_file_placement.md / W2). All ephemeral agent
# output — debug renders, temp downloads, one-off analysis, API response
# dumps, throwaway scripts — lands here and is never committed.
/.scratch/

# Chat-title artifact (generated by tools/rename-chat.py)
.claude/chat-title

# Playgrounds — auto-generated files
workspace/playgrounds/spec-data.js

# Client context — API keys, auth tokens, infrastructure IDs, comms logs
# Per CLAUDE.md: "Client knowledge (IDs, mappings) → context/ only"
#
# The WHOLE context/ tree, no exceptions: comms-log entries, Instantly/Make
# API keys, raw lead exports, and PII land here, and the repo is public.
# (A `context/portable/` opt-in existed until 2026-10-29; no client ever used
# it, and a committable hole inside the secret home is the wrong default.)
workspace/clients/*/context/

# Session context YAMLs — contain inline API keys
docs/sessions/*-context.yaml

# Private checkpoints (personal sessions; checkpoint_scaffold finalize with
# "private": true writes them in the primary clone). Layout plan W1-10.
docs/personal/

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Hook diagnostic log — runtime artifact, grows by ~1000 lines/session.
# Read live by hooks for cross-call state; never used for historical analysis
# by tracked code. Cross-device debugging works without committed history
# because hooks write to it from scratch on a fresh device.
.claude/hooks/hook-log.txt

# Platform (Next.js)
platform/.next/
platform/node_modules/
platform/.env.local

# Root node_modules (no JS deps live at repo root; Remotion once dropped its
# browser cache here — keep git status clean if a stray npm/npx run recurs)
/node_modules/

# Ruff lint cache (regenerable; was untracked-but-not-ignored until 2026-07-17)
.ruff_cache/

# Per-build artifacts (anchor validation report) — regenerated each build
platform/public/docs/*/.build-report.txt

# Playwright MCP runtime snapshots — scratch artifacts, regenerated per session
.playwright-mcp/

# Scratch screenshots dropped at repo root by local-web / browser work
/after-*.jpeg
/anchor-*.jpeg
/*-live-hero.jpeg

# Office lock files (open-document temp markers)
~$*.xlsx
**/~$*.xlsx

# Local hours-tracking workbooks (personal working data, not repo content)
/workspace/hours-tracker/
/workspace/hours-tracker.xlsx

# WW build output (the ww-build-* scripts write meeting bundles and demos
# under /output/) and webhook captures (carried over from the WW repo's
# .gitignore), plus harness-created worktrees, which until now were hidden
# only by the primary's .git/info/exclude. Layout plan W1-20.
/output/
/webhook-dump*.json
.claude/worktrees/

# Scheduled-tasks runtime lock
.claude/scheduled_tasks.lock

# Serena MCP project cache (index/memories) - regenerated per project, machine-local
.serena/

# Aesthetics-audit score snapshots (derived; trend is per-machine state)
workspace/projects/local-web/.critique/

# Confidential third-party client material (assessment internals and audio
# briefings). Never commit.
workspace/clients/Jochen Projekt/

# optimize-loop run state + per-run scorer logs (rule_optimize_loop.md)
/.claude/optimize/
docs/optimize/*/logs/

# Vinted watcher: accumulated market DB + session state (machine-local), ntfy topic
workspace/projects/vinted-reselling/data/
workspace/projects/vinted-reselling/context/.env
.mcp.local.json
