**/google-oauth/token.json

# MCP config (contains API credentials for client instances)
.mcp.json

# Internal tools and credentials (your testing environment)
internal/

# Scripts with hardcoded credentials
scripts/update_workflows.py

# Playgrounds — auto-generated files
workspace/playgrounds/spec-data.js

# Client context — API keys, auth tokens, infrastructure IDs, comms logs
# Per CLAUDE.md: "Client knowledge (IDs, mappings) → context/ only"
workspace/clients/*/context/

# Session context YAMLs — contain inline API keys
docs/sessions/*-context.yaml

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Platform (Next.js)
platform/.next/
platform/node_modules/
platform/.env.local
