                    {
                      "a": "{{13.value}}",
                      "b": "2",
                      "o": "text:equal"
                    },
                    {
                      "a": "{{if(14.value < formatDate(now; \"YYYY-MM-DDTHH:mm:ssZ\"); \"due\"; \"notdue\")}}",
                      "b": "due",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "mapper": {
                "to": "{{11.value}}",
                "subject": "{{replace(replace(60.subject; \"##name##\"; ifempty(10.value; \"there\")); \"##topic##\"; ifempty(12.value; \"your enquiry\"))}}",
                "fromName": "{{62.company_name}}",
                "content": "{{\"<html><body>\" + replace(replace(replace(replace(60.body_html; \"##name##\"; ifempty(10.value; \"there\")); \"##topic##\"; ifempty(12.value; \"your enquiry\")); \"##ai_opening##\"; if(length(ifempty(70.data.choices[1].message.content; \"\")) > 0; \"<p>\" + 70.data.choices[1].message.content + \"</p>\"; \"\")); \"##signature##\"; ifempty(62.email_signature_html; \"\")) + \"</body></html>\"}}",
