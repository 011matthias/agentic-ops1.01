        "url": "https://api.openai.com/v1/chat/completions",
        "data": "{\"model\":\"{{62.ai_model}}\",\"messages\":[{\"role\":\"system\",\"content\":\"{{62.ai_system_prompt}}\"},{\"role\":\"user\",\"content\":\"Name: {{ifempty(10.value; \"there\")}}. Topic: {{ifempty(12.value; \"general enquiry\")}}. Step: {{if(13.value = \"2\"; \"first follow-up, sent a day after their initial enquiry\"; \"final follow-up before we stop reaching out\")}}.\"}],\"max_tokens\":{{parseNumber(62.ai_max_tokens; \".\")}},\"temperature\":{{parseNumber(62.ai_temperature; \".\")}}}",
        "gzip": true,
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{62.ai_api_key}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "useMtls": false,
        "bodyType": "raw",
        "contentType": "application/json",
        "shareCookies": false,
        "parseResponse": true,
        "followRedirect": true,
        "useQuerystring": false,
        "rejectUnauthorized": true
      },
      "module": "http:ActionSendData",
