# Client Automation Environment Variables
# Copy to .env and fill in values

# === Client Identification ===
CLIENT_ID=template-client

# === Database ===
# SQLite for local dev, PostgreSQL for Railway
DATABASE_URL=sqlite:///./logs.db

# === Dashboard Authentication ===
# Simple password for client dashboard access
DASHBOARD_PASSWORD=changeme

# === Internal API ===
# Key for cron jobs to call /run endpoints
INTERNAL_API_KEY=changeme

# === Self-Healing (optional) ===
# External webhook to notify Claude agent on failure
SELF_HEALING_WEBHOOK=

# === Notifications (optional) ===
SLACK_WEBHOOK_URL=

# === Client-Specific API Keys ===
# Add your integrations below:

# Fortnox
# FORTNOX_CLIENT_ID=
# FORTNOX_CLIENT_SECRET=
# FORTNOX_ACCESS_TOKEN=
# FORTNOX_REFRESH_TOKEN=

# Upsales
# UPSALES_API_KEY=

# Google (service account JSON, base64 encoded)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Railway provides these automatically:
# RAILWAY_PUBLIC_DOMAIN
# PORT
