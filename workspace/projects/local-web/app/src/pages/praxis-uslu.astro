---
import BaseLayout from "@layouts/BaseLayout.astro";
import Figure from "@components/Figure.astro";
import "@fontsource-variable/newsreader";
import "@sites/praxis-uslu/theme.css";
import { praxis, CHECK } from "@sites/praxis-uslu/data";

const fullAddress = `${praxis.address.street}, ${praxis.address.zip} ${praxis.address.city}`;

const dayMap: Record<string, string> = {
  Montag: "Monday",
  Dienstag: "Tuesday",
  Mittwoch: "Wednesday",
  Donnerstag: "Thursday",
  Freitag: "Friday",
};

const openingHoursSpecification = praxis.hours
  .filter((h) => h.times.length > 0)
  .flatMap((h) =>
    h.times.map((t) => {
      const [opens, closes] = t.split(" – ");
      return {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: `https://schema.org/${dayMap[h.day]}`,
        opens,
        closes,
      };
    }),
  );

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: praxis.name,
  description: praxis.tagline,
  medicalSpecialty: "PrimaryCare",
  address: {
    "@type": "PostalAddress",
    streetAddress: praxis.address.street,
    postalCode: praxis.address.zip,
    addressLocality: praxis.address.city,
    addressCountry: "DE",
  },
  telephone: praxis.phone,
  faxNumber: praxis.fax,
  url: "https://praxis-uslu.de",
  openingHoursSpecification,
};

const title = `${praxis.name}: Hausärztin in Karlsruhe-Mühlburg`;
const description =
  "Hausärztliche Praxis Dr. med. Sema Uslu in Karlsruhe-Mühlburg: Allgemeinmedizin, Naturheilverfahren, Akupunktur, Hautkrebsscreening. Sprechzeiten und Kontakt.";
---

<BaseLayout
  site="praxis-uslu"
  lang="de"
  title={title}
  description={description}
  path="/praxis-uslu"
  jsonLd={jsonLd}
>
  <header class="site-head">
    <div class="wrap site-head__row">
      <a href="#main" class="brand">
        <span class="brand__name">{praxis.doctor}</span>
        <span class="brand__role">{praxis.role}</span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Hauptnavigation">
        <a href="#leistungen">Leistungen</a>
        <a href="#praxis">Praxis</a>
        <a href="#kontakt">Sprechzeiten</a>
        <a class="btn btn-primary site-nav__cta" href={praxis.phoneHref}>
          Anrufen
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    {/* Hero: editorial split. Serif statement carries the left; a warm,
        real, EMPTY interior anchors the right as a tall column. Distinct
        from helmle-physio (no facts-card-right, no photo band below). */}
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__lede">
          <p class="eyebrow">Hausarztpraxis · Karlsruhe-Mühlburg</p>
          <h1>
            Eine Hausarztpraxis, die sich
            <em>Zeit</em> nimmt.
          </h1>
          <p class="hero__sub">{praxis.tagline}</p>
          <div class="hero__actions">
            <a class="btn btn-primary" href={praxis.phoneHref}>
              Termin telefonisch · {praxis.phone}
            </a>
            <a class="btn btn-ghost" href="#kontakt">Sprechzeiten ansehen</a>
          </div>
          <ul class="hero__tags" aria-label="Schwerpunkte">
            {praxis.specialisations.map((s) => <li>{s}</li>)}
          </ul>
          <p class="hero__meta">
            {fullAddress}
            <span aria-hidden="true"> · </span>
            <span id="open-state" class="open-state">Sprechzeiten unten</span>
          </p>
        </div>

        <div class="hero__media" data-reveal>
          <Figure
            site="praxis-uslu"
            name="hero"
            label="Praxisraum mit warmem Tageslicht"
            ratio="4 / 5"
            rounded="var(--radius-xl)"
            priority
            kenburns
            sizes="(min-width: 54rem) 30rem, 92vw"
          />
        </div>
      </div>
    </section>

    {/* Leistungen: editorial hairline list, NOT a card grid. */}
    <section id="leistungen" class="section">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <p class="eyebrow">Leistungen</p>
          <h2>Was wir in der Praxis abdecken</h2>
          <p class="section__intro">
            Allgemeinmedizinische Versorgung, ergänzt um Naturheilverfahren
            und Akupunktur, abgestimmt auf den einzelnen Menschen.
          </p>
        </header>
        <ol class="leistungen" data-reveal-group>
          {
            praxis.services.map((s, i) => (
              <li class="leistung" data-reveal>
                <span class="leistung__no">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="leistung__body">
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* Signature band "In der Praxis": bespoke, accent-soft surface. */}
    <section id="praxis" class="signature">
      <div class="wrap signature__grid">
        <div class="signature__media" data-reveal>
          <Figure
            site="praxis-uslu"
            name="signature"
            label="Naturheilkunde, Heilkräuter, ruhiges Tageslicht"
            ratio="4 / 5"
            rounded="var(--radius-xl)"
            sizes="(min-width: 54rem) 28rem, 92vw"
          />
        </div>
        <div class="signature__text" data-reveal>
          <p class="eyebrow">In der Praxis</p>
          <h2>Schulmedizin und Naturheilkunde, in einer Hand.</h2>
          <p>
            Die Praxis verbindet die hausärztliche Grundversorgung mit
            Naturheilverfahren und Akupunktur. Das heißt: erst zuhören und
            untersuchen, dann gemeinsam entscheiden, welcher Weg, ob
            schulmedizinisch, naturheilkundlich oder beides, im konkreten
            Fall der richtige ist.
          </p>
          <dl class="signature__facts">
            <div>
              <dt>Sprachen</dt>
              <dd>
                {
                  praxis.languages === CHECK ? (
                    <span class="pending">auf Anfrage</span>
                  ) : (
                    praxis.languages
                  )
                }
              </dd>
            </div>
            <div>
              <dt>Kassen</dt>
              <dd>
                {
                  praxis.kassen === CHECK ? (
                    <span class="pending">gesetzlich & privat, auf Anfrage</span>
                  ) : (
                    praxis.kassen
                  )
                }
              </dd>
            </div>
            {
              praxis.team !== CHECK && (
                <div>
                  <dt>Team</dt>
                  <dd>{praxis.team}</dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>
    </section>

    {/* Sprechzeiten und Anfahrt: precise data block (what patients need). */}
    <section id="kontakt" class="section">
      <div class="wrap contact__grid">
        <div data-reveal>
          <p class="eyebrow">Sprechzeiten</p>
          <h2>Wann Sie uns erreichen</h2>
          <table class="hours">
            <tbody>
              {
                praxis.hours.map((h) => (
                  <tr class={h.times.length === 0 ? "is-closed" : ""}>
                    <th scope="row">{h.day}</th>
                    <td>
                      {h.times.length === 0
                        ? "geschlossen"
                        : h.times.join("  ·  ")}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="contact__side" data-reveal>
          <div class="card contact__card">
            <p class="eyebrow">Kontakt & Anfahrt</p>
            <address class="contact__addr">
              <strong>{praxis.name}</strong><br />
              {praxis.address.street}<br />
              {praxis.address.zip}
              {praxis.address.city} ({praxis.address.district})
            </address>
            <dl class="facts">
              <div>
                <dt>Telefon</dt>
                <dd><a href={praxis.phoneHref}>{praxis.phone}</a></dd>
              </div>
              <div>
                <dt>Fax</dt>
                <dd>{praxis.fax}</dd>
              </div>
              {
                praxis.email !== CHECK && (
                  <div>
                    <dt>E-Mail</dt>
                    <dd>{praxis.email}</dd>
                  </div>
                )
              }
            </dl>
          </div>

          <div class="card emergency" role="note">
            <p class="eyebrow">Im Notfall</p>
            <p>
              Außerhalb der Sprechzeiten: ärztlicher Bereitschaftsdienst
              <a href="tel:116117"><strong>{praxis.emergency.bereitschaft}</strong></a
              >. Bei akuter Lebensgefahr immer
              <a href="tel:112"><strong>{praxis.emergency.notruf}</strong></a>.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap site-foot__row">
      <p>
        {praxis.name} · {fullAddress} ·
        <a href={praxis.phoneHref}>{praxis.phone}</a>
      </p>
      <p class="site-foot__legal">
        Impressum und Datenschutz folgen vor Veröffentlichung. Bilder: Pexels.
      </p>
    </div>
  </footer>
</BaseLayout>

<script>
  // Progressive enhancement: upgrade the open-state line if JS is on.
  // Hours mirror src/sites/praxis-uslu/data.ts (kept in sync by hand).
  const SCHEDULE: Record<number, [number, number][]> = {
    1: [
      [8, 12],
      [14, 18],
    ],
    2: [[8, 13]],
    3: [[7, 13]],
    4: [
      [8, 12],
      [14, 18],
    ],
    5: [[8, 13]],
  };
  const el = document.getElementById("open-state");
  if (el) {
    const now = new Date();
    const blocks = SCHEDULE[now.getDay()] ?? [];
    const h = now.getHours() + now.getMinutes() / 60;
    const open = blocks.some(([a, b]) => h >= a && h < b);
    el.textContent = open ? "Jetzt geöffnet" : "Aktuell geschlossen";
    el.classList.add(open ? "is-open" : "is-shut");
  }

  // Mobile nav: full-screen overlay toggle + sticky scroll-shrink.
  const head = document.querySelector(".site-head");
  const toggle = document.querySelector(".nav-toggle");
  const nav = document.getElementById("site-nav");
  if (head && toggle && nav) {
    toggle.addEventListener("click", () => {
      const isOpen = head.classList.toggle("is-menu-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      document.body.style.overflow = isOpen ? "hidden" : "";
    });
    nav.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        head.classList.remove("is-menu-open");
        toggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      })
    );
  }
  if (head) {
    const onScroll = () => head.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  /* praxis-uslu bespoke layout. Tokens come from theme.css. */
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }
  .site-head__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.35rem;
    transition: padding-block 0.2s ease;
  }
  .site-head.is-scrolled .site-head__row {
    padding-block: 0.95rem;
  }
  .brand {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .brand__role {
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  /* Exclude the CTA so it never receives muted; its colour comes solely
     from .btn-primary / .site-nav__cta (accent-ink). */
  .site-nav a:not(.site-nav__cta) {
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
  }
  .site-nav a:not(.site-nav__cta):hover {
    color: var(--color-ink);
  }
  .site-nav a.site-nav__cta {
    color: var(--color-accent-ink);
    padding: 0.6rem 1.1rem;
    font-size: var(--text-sm);
  }
  .site-nav a.site-nav__cta:hover {
    color: var(--color-accent-ink);
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    box-sizing: border-box;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
    z-index: 60;
  }
  .nav-toggle__bar {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--color-ink);
    transition: transform 0.2s ease, width 0.2s ease;
  }
  .nav-toggle__bar:first-child { width: 26px; }
  .nav-toggle__bar:last-child { width: 18px; }
  .site-head.is-menu-open .nav-toggle__bar:first-child {
    width: 26px;
    transform: translateY(3.5px) rotate(45deg);
  }
  .site-head.is-menu-open .nav-toggle__bar:last-child {
    width: 26px;
    transform: translateY(-3.5px) rotate(-45deg);
  }
  @media (max-width: 640px) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 1.75rem;
      background: var(--color-paper);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
      z-index: 55;
    }
    .site-head.is-menu-open .site-nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .site-nav a:not(.site-nav__cta) {
      font-size: var(--text-2xl);
    }
    .site-nav a.site-nav__cta {
      margin-top: 0.5rem;
      padding: 0.85rem 1.6rem;
      font-size: var(--text-lg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-head__row,
    .nav-toggle__bar,
    .site-nav {
      transition: none;
    }
  }

  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 6vw, 5rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero h1 {
    font-size: var(--text-4xl);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.03;
    margin-block: 0.7rem 0;
    max-width: 15ch;
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--color-accent);
  }
  .hero__sub {
    font-size: var(--text-xl);
    color: var(--color-muted);
    max-width: 34ch;
    margin-block: 1.4rem 0;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-block: 2rem 1.5rem;
  }
  .hero__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .hero__tags li {
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.32rem 0.75rem;
    background: var(--color-surface);
  }
  .hero__meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .open-state {
    font-weight: 600;
  }
  .open-state.is-open {
    color: var(--color-accent);
  }
  .hero__media :global(.figure) {
    box-shadow: var(--shadow-card);
  }

  /* One consistent warm grade across both site photographs (skil_web-build
     List B4): subtle warm white-balance + a touch of saturation, applied
     identically to hero + signature so they read as one set. */
  .hero__media :global(img),
  .signature__media :global(img) {
    filter: saturate(1.08) sepia(0.08) brightness(1.02) contrast(1.01);
  }

  .section {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }
  .section__head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .section__head h2,
  .signature h2,
  .contact__grid h2 {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.012em;
    margin-block: 0.5rem 0;
  }
  .section__intro {
    color: var(--color-muted);
    font-size: var(--text-lg);
    margin-top: 1rem;
  }

  .leistungen {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .leistung {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-line);
  }
  .leistung__no {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-accent);
  }
  .leistung__body h3 {
    font-size: var(--text-xl);
    font-weight: 600;
  }
  .leistung__body p {
    color: var(--color-muted);
    margin-block: 0.5rem 0;
    max-width: 60ch;
  }

  .signature {
    background: var(--color-accent-soft);
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .signature__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .signature__text h2 {
    max-width: 16ch;
  }
  .signature__text > p {
    margin-top: 1.25rem;
    max-width: 58ch;
  }
  .signature__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
    margin-block: 2rem 0;
  }
  .signature__facts dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .signature__facts dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .hours {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
    font-weight: 500;
  }
  .hours td {
    text-align: right;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .hours .is-closed th,
  .hours .is-closed td {
    color: var(--color-muted);
  }
  .contact__side {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .contact__card,
  .emergency {
    padding: 1.75rem;
  }
  .facts {
    margin: 1rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .facts div {
    display: grid;
    gap: 0.15rem;
  }
  .facts dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .facts dd {
    margin: 0;
    font-size: var(--text-base);
  }
  .facts a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .contact__addr {
    font-style: normal;
    margin-block: 1rem;
    line-height: 1.7;
  }
  .emergency {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .emergency .eyebrow {
    color: color-mix(in srgb, var(--color-paper) 70%, transparent);
  }
  .emergency a {
    color: var(--color-paper);
  }

  /* Quiet pending treatment: honest gaps read as calm prose, never an
     ALL-CAPS bracketed sentinel chip. data.ts keeps the CHECK source of
     truth; only the visible string changes (skil_web-build List A5). */
  .pending {
    color: var(--color-muted);
    font-weight: 500;
    font-style: italic;
  }

  .site-foot {
    border-top: 1px solid var(--color-line);
    padding-block: 2.5rem;
  }
  .site-foot__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .site-foot a {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .hero__grid,
    .signature__grid,
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .hero h1 {
      max-width: 18ch;
    }
    .signature__media {
      max-width: 26rem;
    }
  }
</style>
